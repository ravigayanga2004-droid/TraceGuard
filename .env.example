# Optional environment variables; this file is documentation, not auto-loaded.
# CLI --state takes precedence over TRACEGUARD_STATE.
TRACEGUARD_STATE=.traceguard
# Email is used only when watch --email is explicitly enabled.
TRACEGUARD_SMTP_HOST=localhost
TRACEGUARD_SMTP_PORT=587
TRACEGUARD_SMTP_TLS=true
TRACEGUARD_SMTP_USER=
TRACEGUARD_SMTP_PASSWORD=
TRACEGUARD_EMAIL_FROM=
TRACEGUARD_EMAIL_TO=
